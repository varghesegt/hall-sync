{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd allocate-artisan && npm install && npm run build",
  "outputDirectory": "allocate-artisan/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hall-sync.onrender.com/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://hall-sync.onrender.com/actuator/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
